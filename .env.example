# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=
# General Information -> Application ID
DISCORD_CLIENT_ID=
# Right-click your server -> Copy Server ID (Discord Developer Mode enabled)
DISCORD_GUILD_ID=

# Spotify Developer Dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Filled locally by npm run spotify:login; required for playlists.
SPOTIFY_REFRESH_TOKEN=
# Add this EXACT redirect URI to the Spotify app settings.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_MARKET=CA
# The Discord bot owner can import private playlists. Optional extra Discord user IDs:
SPOTIFY_PRIVATE_PLAYLIST_USERS=

# Slash commands and @ttballerbot play always work. !play needs Message Content Intent enabled
# on the Discord Bot page as well as this setting.
ENABLE_MESSAGE_COMMANDS=false
COMMAND_PREFIX=!
MAX_QUEUE_SIZE=250
IDLE_TIMEOUT_SECONDS=180
# Leave blank to use local bin/yt-dlp or PATH.
YTDLP_PATH=
FFMPEG_PATH=ffmpeg

# Experimental heyTT branch. Off by default; /hey on opts in each individual.
ENABLE_HEY_BALLER=false
# Needed for post-wake transcription and the AI announcer. Never commit a real key.
GEMINI_API_KEY=
VOICE_TRANSCRIPTION_MODEL=gemini-3.1-flash-lite
VOICE_SPEECH_MODEL=gemini-3.8-flash-tts
VOICE_ANNOUNCER=Fenrir

# Optional private, consented Fish Audio voice. Set both together to replace Gemini TTS.
# Gemini still understands requests. Never commit recordings, keys, or private voice IDs.
FISH_API_KEY=
FISH_REFERENCE_ID=
# Explicit free model; never automatically falls back to a paid model.
FISH_SPEECH_MODEL=s2.1-pro-free
