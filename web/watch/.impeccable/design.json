  "narrative": {
    "northStar": "The shared-window control desk",
    "overview": "This scoped system records the implementation in `index.html`, `style.css`, and `app.js`. It extends the existing ttballerbot player identity: deep green surfaces, mint actions, pale text, and condensed Barlow headlines. The project-root `DESIGN.md` remains the authority for the Discord player; these rules describe the local spectator companion.\n\nThe companion has a quiet, practical control surface with a large window preview and friendly display typography. Familiar browser controls and plain status text carry operational information. It uses flat color, real preview content, and clear boundaries rather than visual activity to imply that work is happening.",
    "keyCharacteristics": [
      "Deep green layers with mint actions and focus indicators.",
      "Condensed Barlow headings with native sans-serif controls and supporting copy.",
      "A dominant, uncropped window preview beside compact settings on desktop.",
      "Plain text states and immediate, visible capture controls."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Color supports status and errors; visible text names the state or corrective action.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Barlow carries the major headings; native sans-serif carries controls, status, and reading copy.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use tonal separation and rules for structure; reserve visible changes for actual interaction or application state.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** retain the existing green and mint identity when extending this companion.",
      "**Do** keep controls close to the preview they operate and preserve the uncropped window image.",
      "**Do** give status, errors, and provider disclosures readable text and honest state changes.",
      "**Do** preserve visible keyboard focus and native disabled behavior.",
      "**Do** allow headings, control rows, and long errors to wrap on narrow screens."
    ],
    "donts": [
      "**Don't** replace real preview content with fabricated activity or progress graphics.",
      "**Don't** add decorative motion or thinking indicators to imply a reaction is guaranteed.",
      "**Don't** rely on color alone to communicate connection, sharing, or failure states.",
      "**Don't** apply this companion's browser layout rules to the Discord player's native controls."
    ]
  }
}
